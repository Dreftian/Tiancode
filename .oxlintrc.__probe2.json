{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc-project.github.io/refs/heads/json-schema/src/public/.oxlintrc.schema.json",
  "options": {
    "typeAware": true
  },
  "categories": {
    "suspicious": "warn"
  },
  "rules": {
    // ── error: small, verified bug classes. Any NEW occurrence fails `bun run lint`. ──
    // Duplicate object-literal keys silently drop the earlier value
    "no-dupe-keys": "error",
    // `x = x` is never intentional
    "no-self-assign": "error",
    // `if (false)` / always-true loops are dead branches
    "no-constant-condition": "error",
    // `(a?.b as T).c` still throws when `a` is nullish — the `?.` buys nothing
    "no-unsafe-optional-chaining": "error",
    // `new Function(...)` / string-bodied setTimeout is a code-injection sink
    "typescript/no-implied-eval": "error",
    "no-eval": ["error", { "allowIndirect": false }],

    // ── warn: real debt, worth fixing later ──
    "typescript/no-base-to-string": "warn",
    // Type-aware: catch unhandled promises
    "typescript/no-floating-promises": "warn",
    // Warn when spreading non-plain objects (Headers, class instances, etc.)
    "typescript/no-misused-spread": "warn",

    // ── off: rules that fight this codebase's idioms ──
    // Effect uses `function*` with Effect.gen/Effect.fnUntraced that don't always yield
    "require-yield": "off",
    // SolidJS uses `let ref: T | undefined` for JSX ref bindings assigned at runtime
    "no-unassigned-vars": "off",
    // SolidJS tracks reactive deps by reading properties inside createEffect
    "no-unused-expressions": "off",
    // Intentional control char matching (ANSI escapes, null byte sanitization)
    "no-control-regex": "off",
    // SST and plugin tools require triple-slash references
    "triple-slash-reference": "off",
    // Effect's nested function* closures inherently shadow outer scope
    "no-shadow": "off",
    // Namespace-heavy codebase makes this too noisy
    "unicorn/consistent-function-scoping": "off",
    // Opinionated — .sort()/.reverse() mutation is fine in this codebase
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    // Not relevant — this isn't a DOM event handler codebase
    "unicorn/prefer-add-event-listener": "off",
    // Bundler handles module resolution
    "unicorn/require-module-specifiers": "off",
    // postMessage target origin not relevant for this codebase
    "unicorn/require-post-message-target-origin": "off",
    // Side-effectful constructors are intentional in some places
    "no-new": "off",

    // The 15 rules below accounted for 4,262 of the 5,145 warnings this config used to emit —
    // enough noise that a genuinely new warning was invisible. Each one is off because it fights
    // an idiom this codebase uses everywhere, not because the debt is inconvenient; `bun turbo
    // typecheck` is the guard for the type-assertion ones.

    // 1985: `as` at decode boundaries is the idiom —
    // `JSON.parse(process.env.TIANCODE_AUTH_CONTENT) as Record<string, unknown>` (backend/tiancode/src/auth/index.ts)
    "typescript/no-unsafe-type-assertion": "off",
    // 932: implicit `undefined` returns are idiomatic here —
    // `function parse(spec) { try { return npa(spec) } catch {} }` (backend/tiancode/src/plugin/shared.ts)
    "typescript/consistent-return": "off",
    // 506: assertions that look redundant under one tsconfig are load-bearing under another
    // (node vs browser conditions, @types/node drift) — `buf.buffer.slice(...) as ArrayBuffer`
    "typescript/no-unnecessary-type-assertion": "off",
    // 271: Effect Schema brands read as duplicates of their base type —
    // `(value: ContentBlockID | string)` (backend/llm/src/schema/events.ts)
    "typescript/no-duplicate-type-constituents": "off",
    // 157: template-literal brands look redundant next to `string` but document intent —
    // `type ColorValue = HexColor | RefName | Variant | RGBA | number` (backend/tiancode/src/cli/cmd/run/theme.ts)
    "typescript/no-redundant-type-constituents": "off",
    // 160: destructuring the SolidJS context factory and passing Effect predicates unbound are
    // both core idioms — `export const { use: useServer, provider: ServerProvider } = createSimpleContext({...})`
    "typescript/unbound-method": "off",
    // 84: explicit Effect type params are documentation, not noise —
    // `owner?: Fiber.Fiber<void, never>` (backend/core/src/session/run-coordinator.ts)
    "typescript/no-unnecessary-type-arguments": "off",
    // 30: single-use generics keep service interfaces inferable at the call site —
    // `readonly write: <T>(key: string[], content: T) => Effect.Effect<void, FSUtil.Error>`
    "typescript/no-unnecessary-type-parameters": "off",
    // 32: generators cannot be arrow functions, so Effect.gen/Layer bodies must alias `this` —
    // `const self = this` before `Effect.gen(function* () {` (backend/codemode/src/interpreter/runtime.ts)
    "typescript/no-this-alias": "off",
    // 27: `!== true` / `=== false` deliberately separates explicit false from absent on
    // `boolean | undefined` — `if (previous?.retry !== true) continue` (backend/tiancode/src/plugin/loader.ts)
    "typescript/no-unnecessary-boolean-literal-compare": "off",
    // 50: defensive normalization across loose union types —
    // `pendingOAuth.reject(new Error(String(message)))` (backend/tiancode/src/plugin/digitalocean.ts)
    "typescript/no-unnecessary-type-conversion": "off",
    // 18: `void` is this codebase's fire-and-forget marker and stays correct if the callee later
    // returns a promise — `void removePersisted(target, platform)` (frontend/app/src/context/layout.tsx)
    "typescript/no-meaningless-void-operator": "off",
    // 3: marker and mock classes are intentional —
    // `export class PromiseNamespace {}` (backend/codemode/src/interpreter/model.ts)
    "typescript/no-extraneous-class": "off",
    // 6: false positives — the flag is mutated from a closure the rule cannot see —
    // `while (!signal?.aborted)` (backend/tiancode/test/acp/service-session.test.ts)
    "no-unmodified-loop-condition": "off",
    // 1: Playwright fixtures require the empty destructure to declare zero dependencies —
    // `reportState: async ({}, use) => use({})` (frontend/app/e2e/performance/benchmark.ts)
    "no-empty-pattern": "off"
  },
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/.build",
    "**/.sst",
    "**/*.d.ts",
    "**/sdk.gen.ts",
    // Astro files are parsed as plain HTML by oxlint and always fail
    "**/*.astro"
  ]
}

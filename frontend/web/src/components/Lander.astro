---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import config from "virtual:starlight/user-config";

import CopyIcon from "../assets/lander/copy.svg";
import CheckIcon from "../assets/lander/check.svg";
import TuiScreenshot from "../assets/lander/screenshot-splash.png";

const github = (config.social || []).filter(s => s.icon === 'github')[0] || { href: "https://github.com/Dreftian/Tiancode" };
const discord = (config.social || []).filter(s => s.icon === 'discord')[0] || { href: "https://discord.gg/tiancode" };
const locale = Astro.currentLocale || 'root';
const docsHref = getRelativeLocaleUrl(locale, "");
const docsCliHref = getRelativeLocaleUrl(locale, "cli");
const docsIdeHref = getRelativeLocaleUrl(locale, "ide");
const docsGithubHref = getRelativeLocaleUrl(locale, "github");

const version = "1.0.58";
---

<div class="tian-lander">
  <!-- Top Navigation / Pill Header -->
  <section class="hero-top">
    <div class="version-badge">
      <span class="pulse-indicator"></span>
      <span class="badge-text">Tiancode v{version} Released</span>
      <span class="badge-sub">Persistent LTM • Auto-Skills • AST Graph</span>
    </div>

    <div class="hero-brand">
      <h1 class="glitch-title">TIANCODE</h1>
      <p class="hero-tagline">The Autonomous, Self-Evolving AI Coding Agent for High-Velocity Software Teams</p>
      <p class="hero-description">
        Runs locally or on your servers. Remembers project quirks across sessions, autonomously distills reusable skills, traces code graphs, and executes fullstack workflows without telemetry.
      </p>
    </div>

    <!-- Quick Install / Action Hub -->
    <div class="install-hub">
      <div class="command-box">
        <div class="terminal-header">
          <div class="dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <div class="tab-list">
            <button class="tab-btn active" data-tab="curl">curl</button>
            <button class="tab-btn" data-tab="bun">bun</button>
            <button class="tab-btn" data-tab="npm">npm</button>
            <button class="tab-btn" data-tab="brew">brew</button>
            <button class="tab-btn" data-tab="powershell">powershell</button>
          </div>
        </div>

        <div class="terminal-body">
          <div class="tab-content active" id="tab-curl">
            <code><span class="prompt">$</span> curl -fsSL https://tiancode.dev/install | bash</code>
            <button class="copy-action" data-command="curl -fsSL https://tiancode.dev/install | bash">
              <CopyIcon /><CheckIcon />
            </button>
          </div>
          <div class="tab-content" id="tab-bun">
            <code><span class="prompt">$</span> bun install -g tiancode-ai</code>
            <button class="copy-action" data-command="bun install -g tiancode-ai">
              <CopyIcon /><CheckIcon />
            </button>
          </div>
          <div class="tab-content" id="tab-npm">
            <code><span class="prompt">$</span> npm install -g tiancode-ai</code>
            <button class="copy-action" data-command="npm install -g tiancode-ai">
              <CopyIcon /><CheckIcon />
            </button>
          </div>
          <div class="tab-content" id="tab-brew">
            <code><span class="prompt">$</span> brew install tiancode</code>
            <button class="copy-action" data-command="brew install tiancode">
              <CopyIcon /><CheckIcon />
            </button>
          </div>
          <div class="tab-content" id="tab-powershell">
            <code><span class="prompt">PS&gt;</span> irm https://tiancode.dev/install.ps1 | iex</code>
            <button class="copy-action" data-command="irm https://tiancode.dev/install.ps1 | iex">
              <CopyIcon /><CheckIcon />
            </button>
          </div>
        </div>
      </div>

      <div class="cta-actions">
        <a href={docsHref} class="btn-primary">Explore Documentation &rarr;</a>
        <a href="https://github.com/Dreftian/Tiancode/releases" class="btn-secondary" target="_blank" rel="noopener noreferrer">
          Download Desktop App (v{version})
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Agent Capabilities Showcase -->
  <section class="showcase-section">
    <div class="section-title">
      <h2>Architected for Real-World Autonomy</h2>
      <p>Tiancode moves beyond single-turn copilot chats into continuous, stateful software engineering.</p>
    </div>

    <div class="interactive-preview">
      <div class="preview-nav">
        <button class="preview-tab active" data-preview="memory">
          <span class="tab-icon">🧠</span> Long-Term Memory (LTM)
        </button>
        <button class="preview-tab" data-preview="skills">
          <span class="tab-icon">⚡</span> Autonomous Skills (/learn)
        </button>
        <button class="preview-tab" data-preview="graph">
          <span class="tab-icon">🔍</span> AST & Code Graph
        </button>
        <button class="preview-tab" data-preview="desktop">
          <span class="tab-icon">🖥️</span> Native Desktop & TUI
        </button>
      </div>

      <div class="preview-display">
        <!-- Tab 1: Memory -->
        <div class="preview-pane active" id="prev-memory">
          <div class="code-header">
            <span class="file-name">.tiancode/MEMORY.md & USER.md (Persistent Context)</span>
            <span class="file-tag">Zero Amnesia</span>
          </div>
          <pre class="code-block"><code><span class="comment"># Tiancode Persistent Long-Term Memory (LTM)</span>
<span class="section">## ARCHITECTURE</span>
- [2026-08-15] Uses Effect-TS layered nodes in backend/core and backend/tiancode
- [2026-08-15] Backend API port is 4000; Vite dev server runs on 5173
- [2026-08-15] SQLite WAL mode enabled with Drizzle schema migrations

<span class="section">## USER PREFERENCES</span>
- [2026-08-15] Prefer bun over npm for package management
- [2026-08-15] Always generate strict TypeScript with explicit return types
- [2026-08-15] Avoid try/catch where Effect generators can be used</code></pre>
        </div>

        <!-- Tab 2: Skills -->
        <div class="preview-pane" id="prev-skills">
          <div class="code-header">
            <span class="file-name">.tiancode/skills/docker-deploy/SKILL.md (Auto-Distilled)</span>
            <span class="file-tag">Self-Evolving</span>
          </div>
          <pre class="code-block"><code><span class="keyword">---</span>
<span class="property">name</span>: <span class="string">docker-deploy</span>
<span class="property">description</span>: <span class="string">Builds multi-stage Docker container and deploys to registry</span>
<span class="keyword">---</span>

<span class="comment"># Automated Docker Deployment Workflow</span>
1. Run lint & typecheck: `bun run typecheck`
2. Build multi-arch image: `docker buildx build --platform linux/amd64 -t app:latest .`
3. Execute smoke healthcheck endpoint on `:8080/health`
4. Post notification to deployment channel upon completion.</code></pre>
        </div>

        <!-- Tab 3: AST Graph -->
        <div class="preview-pane" id="prev-graph">
          <div class="code-header">
            <span class="file-name">Tiancode Code Graph & Symbol Resolver</span>
            <span class="file-tag">Deep Context</span>
          </div>
          <pre class="code-block"><code><span class="keyword">&lt;code_graph</span> <span class="property">file</span>=<span class="string">"backend/core/src/memory.ts"</span><span class="keyword">&gt;</span>
  <span class="keyword">&lt;exports&gt;</span>
    <span class="tag">&lt;symbol</span> <span class="property">kind</span>=<span class="string">"class"</span> <span class="property">line</span>=<span class="string">"22"</span><span class="tag">&gt;</span>Memory.Service<span class="tag">&lt;/symbol&gt;</span>
    <span class="tag">&lt;symbol</span> <span class="property">kind</span>=<span class="string">"function"</span> <span class="property">line</span>=<span class="string">"64"</span><span class="tag">&gt;</span>Memory.recall<span class="tag">&lt;/symbol&gt;</span>
  <span class="keyword">&lt;/exports&gt;</span>
  <span class="keyword">&lt;dependents&gt;</span>
    <span class="tag">&lt;file&gt;</span>backend/tiancode/src/session/system.ts<span class="tag">&lt;/file&gt;</span>
    <span class="tag">&lt;file&gt;</span>backend/tiancode/src/tool/memory.ts<span class="tag">&lt;/file&gt;</span>
  <span class="keyword">&lt;/dependents&gt;</span>
<span class="keyword">&lt;/code_graph&gt;</span></code></pre>
        </div>

        <!-- Tab 4: Desktop -->
        <div class="preview-pane" id="prev-desktop">
          <div class="screenshot-wrapper">
            <Image src={TuiScreenshot} alt="Tiancode Native Interface" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Grid -->
  <section class="features-grid">
    <div class="feature-card">
      <div class="feature-icon">🧠</div>
      <h3>Persistent Multi-Tier Memory (LTM)</h3>
      <p>No more restarting from scratch. Tiancode remembers your coding style, architectural gotchas, build quirks, and past solutions across every session.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">⚡</div>
      <h3>Self-Evolution & Dynamic Skills</h3>
      <p>When Tiancode solves a difficult task, it can distill the entire workflow into a persistent, reusable skill with <code>/learn</code> for instant future reuse.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">🔍</div>
      <h3>AST & Code Graph Engine</h3>
      <p>Semantic understanding of your entire repository. Traces call trees, imports, and downstream dependencies to eliminate regressions before they happen.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">🌐</div>
      <h3>Clean Web Scraping & Firecrawl</h3>
      <p>Extracts pristine, LLM-ready markdown from web pages and documentation, stripping cookie banners, ads, and navigation noise automatically.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">🛡️</div>
      <h3>Local Privacy & Sandboxed Execution</h3>
      <p>Your code stays on your machine. Zero telemetry, full support for local models (Ollama, LM Studio), and optional Docker sandbox execution.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">🤖</div>
      <h3>Universal Multi-Model Support</h3>
      <p>Seamlessly switch between Claude 3.7 Sonnet, GPT-4.5 / o3, Gemini 2.5 Pro, DeepSeek R1, Qwen 2.5 Coder, or your private local weights.</p>
    </div>
  </section>

  <!-- Download & Platform Matrix -->
  <section class="download-section">
    <div class="section-title">
      <h2>Get Started with Tiancode</h2>
      <p>Available as a standalone desktop app, high-performance terminal TUI, or CLI daemon.</p>
    </div>

    <div class="platforms-grid">
      <div class="platform-card">
        <h4>Windows</h4>
        <p>Windows 10 / 11 (x64 / ARM64)</p>
        <div class="platform-links">
          <a href="https://github.com/Dreftian/Tiancode/releases" class="p-btn">Tiancode.exe</a>
          <a href="https://github.com/Dreftian/Tiancode/releases" class="p-btn secondary">Portable</a>
        </div>
      </div>

      <div class="platform-card">
        <h4>macOS</h4>
        <p>Apple Silicon & Intel (12.0+)</p>
        <div class="platform-links">
          <a href="https://github.com/Dreftian/Tiancode/releases" class="p-btn">.dmg (Universal)</a>
          <a href={docsCliHref} class="p-btn secondary">brew install</a>
        </div>
      </div>

      <div class="platform-card">
        <h4>Linux & Server</h4>
        <p>Ubuntu, Debian, Fedora, Arch</p>
        <div class="platform-links">
          <a href="https://github.com/Dreftian/Tiancode/releases" class="p-btn">.deb / AppImage</a>
          <a href={docsCliHref} class="p-btn secondary">curl install</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Modern Footer -->
  <footer class="tian-footer">
    <div class="footer-col brand-col">
      <span class="footer-logo">TIANCODE</span>
      <p>Autonomous AI pair programmer and agentic workspace.</p>
      <span class="copyright">&copy; 2026 Tiancode AI. MIT License.</span>
    </div>
    <div class="footer-col">
      <h5>Documentation</h5>
      <a href={docsHref}>Overview</a>
      <a href={docsCliHref}>CLI & TUI</a>
      <a href={docsIdeHref}>Desktop & IDE</a>
      <a href={docsGithubHref}>GitHub Actions</a>
    </div>
    <div class="footer-col">
      <h5>Community</h5>
      <a href={github.href} target="_blank" rel="noopener noreferrer">GitHub Repository</a>
      <a href={discord.href} target="_blank" rel="noopener noreferrer">Discord Server</a>
      <a href="https://models.dev" target="_blank" rel="noopener noreferrer">Models.dev</a>
    </div>
  </footer>
</div>

<style>
.tian-lander {
  --primary-accent: hsl(60, 90%, 65%);
  --primary-glow: hsla(60, 90%, 65%, 0.15);
  --surface-bg: hsla(0, 0%, 100%, 0.03);
  --surface-border: hsla(0, 0%, 100%, 0.1);
  --text-main: hsl(0, 0%, 95%);
  --text-muted: hsl(0, 0%, 65%);

  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 1.5rem 4rem 1.5rem;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: var(--text-main);
}

/* Version Pill */
.hero-top {
  text-align: center;
  padding: 3rem 1rem 4rem 1rem;
}

.version-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.35rem 0.9rem;
  background: var(--surface-bg);
  border: 1px solid var(--surface-border);
  border-radius: 9999px;
  font-size: 0.82rem;
  margin-bottom: 2rem;
  backdrop-filter: blur(12px);
}

.pulse-indicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 10px #22c55e;
}

.badge-text {
  font-weight: 600;
  color: var(--text-main);
}

.badge-sub {
  color: var(--text-muted);
  border-left: 1px solid var(--surface-border);
  padding-left: 0.5rem;
}

.hero-brand h1.glitch-title {
  font-size: clamp(2.5rem, 7vw, 4.8rem);
  font-weight: 800;
  letter-spacing: -0.04em;
  line-height: 1.05;
  margin: 0 0 1rem 0;
  background: linear-gradient(180deg, #ffffff 40%, rgba(255, 255, 255, 0.6) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-tagline {
  font-size: clamp(1.15rem, 2.5vw, 1.5rem);
  font-weight: 600;
  color: var(--primary-accent);
  margin: 0 0 1rem 0;
  letter-spacing: -0.01em;
}

.hero-description {
  font-size: 1.05rem;
  color: var(--text-muted);
  max-width: 720px;
  margin: 0 auto 2.5rem auto;
  line-height: 1.6;
}

/* Install Terminal Hub */
.install-hub {
  max-width: 680px;
  margin: 0 auto;
}

.command-box {
  background: hsl(0, 0%, 7%);
  border: 1px solid var(--surface-border);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  text-align: left;
}

.terminal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.6rem 1rem;
  background: hsl(0, 0%, 10%);
  border-bottom: 1px solid var(--surface-border);
}

.dots {
  display: flex;
  gap: 6px;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}
.dot.red { background: #ef4444; }
.dot.yellow { background: #f59e0b; }
.dot.green { background: #10b981; }

.tab-list {
  display: flex;
  gap: 4px;
}

.tab-btn {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 0.8rem;
  padding: 0.25rem 0.6rem;
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.tab-btn:hover,
.tab-btn.active {
  color: var(--text-main);
  background: hsl(0, 0%, 16%);
}

.terminal-body {
  padding: 1rem 1.25rem;
}

.tab-content {
  display: none;
  align-items: center;
  justify-content: space-between;
  font-family: 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.95rem;
}

.tab-content.active {
  display: flex;
}

.prompt {
  color: var(--primary-accent);
  margin-right: 0.5rem;
}

.copy-action {
  background: hsl(0, 0%, 14%);
  border: 1px solid var(--surface-border);
  border-radius: 6px;
  padding: 0.4rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  transition: all 0.2s ease;
}

.copy-action:hover {
  background: hsl(0, 0%, 20%);
  color: var(--text-main);
}

.copy-action svg:last-child {
  display: none;
}

.copy-action.success svg:first-child {
  display: none;
}

.copy-action.success svg:last-child {
  display: block;
  color: #22c55e;
}

.cta-actions {
  display: flex;
  gap: 1rem;
  justify-content: center;
  margin-top: 1.5rem;
  flex-wrap: wrap;
}

.btn-primary {
  background: #ffffff;
  color: #000000;
  font-weight: 600;
  padding: 0.75rem 1.5rem;
  border-radius: 8px;
  text-decoration: none;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.btn-primary:hover {
  opacity: 0.9;
  transform: translateY(-1px);
}

.btn-secondary {
  background: var(--surface-bg);
  color: var(--text-main);
  border: 1px solid var(--surface-border);
  font-weight: 500;
  padding: 0.75rem 1.5rem;
  border-radius: 8px;
  text-decoration: none;
  backdrop-filter: blur(8px);
  transition: all 0.2s ease;
}

.btn-secondary:hover {
  background: hsla(0, 0%, 100%, 0.08);
  border-color: var(--text-muted);
}

/* Showcase Section */
.showcase-section {
  padding: 4rem 0;
}

.section-title {
  text-align: center;
  margin-bottom: 2.5rem;
}

.section-title h2 {
  font-size: clamp(1.8rem, 4vw, 2.5rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0 0 0.5rem 0;
}

.section-title p {
  color: var(--text-muted);
  font-size: 1.05rem;
  max-width: 600px;
  margin: 0 auto;
}

.interactive-preview {
  background: hsl(0, 0%, 6%);
  border: 1px solid var(--surface-border);
  border-radius: 16px;
  overflow: hidden;
}

.preview-nav {
  display: flex;
  border-bottom: 1px solid var(--surface-border);
  background: hsl(0, 0%, 8%);
  overflow-x: auto;
}

.preview-tab {
  flex: 1;
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 0.9rem;
  font-weight: 500;
  padding: 0.9rem 1.2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  white-space: nowrap;
  border-bottom: 2px solid transparent;
  transition: all 0.2s ease;
}

.preview-tab:hover {
  color: var(--text-main);
  background: hsl(0, 0%, 10%);
}

.preview-tab.active {
  color: var(--text-main);
  background: hsl(0, 0%, 12%);
  border-bottom-color: var(--primary-accent);
}

.preview-pane {
  display: none;
  padding: 1.5rem;
}

.preview-pane.active {
  display: block;
}

.code-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--surface-border);
  font-size: 0.85rem;
}

.file-name {
  color: var(--text-muted);
  font-family: monospace;
}

.file-tag {
  background: var(--primary-glow);
  color: var(--primary-accent);
  padding: 0.2rem 0.5rem;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 600;
}

.code-block {
  margin: 0;
  padding: 1.2rem;
  background: hsl(0, 0%, 4%);
  border-radius: 8px;
  font-family: 'Fira Code', ui-monospace, monospace;
  font-size: 0.88rem;
  line-height: 1.55;
  overflow-x: auto;
}

.code-block .comment { color: hsl(0, 0%, 45%); }
.code-block .section { color: hsl(200, 90%, 65%); font-weight: 600; }
.code-block .keyword { color: hsl(330, 85%, 65%); }
.code-block .property { color: hsl(45, 90%, 60%); }
.code-block .string { color: hsl(120, 70%, 60%); }
.code-block .tag { color: hsl(180, 80%, 60%); }

.screenshot-wrapper {
  text-align: center;
  padding: 1rem;
}

.screenshot-wrapper img {
  max-width: 100%;
  height: auto;
  border-radius: 8px;
  border: 1px solid var(--surface-border);
}

/* Feature Grid */
.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 1.5rem;
  padding: 4rem 0;
}

.feature-card {
  background: var(--surface-bg);
  border: 1px solid var(--surface-border);
  border-radius: 12px;
  padding: 1.8rem;
  backdrop-filter: blur(8px);
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.feature-card:hover {
  transform: translateY(-2px);
  border-color: hsla(0, 0%, 100%, 0.25);
}

.feature-icon {
  font-size: 1.8rem;
  margin-bottom: 1rem;
}

.feature-card h3 {
  font-size: 1.15rem;
  font-weight: 600;
  margin: 0 0 0.5rem 0;
  color: var(--text-main);
}

.feature-card p {
  color: var(--text-muted);
  font-size: 0.92rem;
  line-height: 1.55;
  margin: 0;
}

/* Download Section */
.download-section {
  padding: 4rem 0;
}

.platforms-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
}

.platform-card {
  background: hsl(0, 0%, 7%);
  border: 1px solid var(--surface-border);
  border-radius: 12px;
  padding: 1.8rem;
  text-align: center;
}

.platform-card h4 {
  font-size: 1.2rem;
  margin: 0 0 0.4rem 0;
}

.platform-card p {
  color: var(--text-muted);
  font-size: 0.85rem;
  margin: 0 0 1.2rem 0;
}

.platform-links {
  display: flex;
  gap: 0.5rem;
  justify-content: center;
}

.p-btn {
  background: var(--text-main);
  color: #000;
  font-size: 0.85rem;
  font-weight: 600;
  padding: 0.5rem 1rem;
  border-radius: 6px;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.p-btn:hover {
  opacity: 0.9;
}

